{
  "name": "pigz",
  "version": "2.8",
  "description": "Parallel implementation of gzip",
  "source": {
    "type": "tarball",
    "url": "https://zlib.net/pigz/pigz-2.8.tar.gz"
  },
  "dependencies": [
    "zlib"
  ],
  "build_dependencies": [],
  "build_system": "custom",
  "build_commands": [
    "make CFLAGS=\"-O3 $CPPFLAGS\" LDFLAGS=\"$LDFLAGS\"",
    "mkdir -p $TSI_INSTALL_DIR/bin $TSI_INSTALL_DIR/share/man/man1",
    "cp pigz unpigz $TSI_INSTALL_DIR/bin/",
    "cp pigz.1 $TSI_INSTALL_DIR/share/man/man1/"
  ],
  "env": {}
}

    "zlib",
    "bzip2",
    "xz",
    "lz4",
    "zstd",
    "brotli"
  ],
  "build_dependencies": [
    "pkg-config"
  ],
  "build_system": "autotools",
  "configure_args": [
    "--with-pcre2=$TSI_INSTALL_DIR",
    "--without-boost-regex"
  ],
  "env": {}

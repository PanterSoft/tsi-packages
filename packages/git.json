{
  "name": "git",
  "versions": [
    {
      "version": "2.44.0",
      "description": "Distributed version control system",
      "source": {
        "type": "tarball",
        "url": "https://www.kernel.org/pub/software/scm/git/git-2.44.0.tar.gz",
        "sha256": "f9e36f085458fe9688fbbe7846b8c4770b13d161fcd8953655f36b2b85f06b76"
      },
      "dependencies": [
        "zlib",
        "openssl",
        "curl",
        "pcre2"
      ],
      "build_dependencies": [
        "pkg-config",
        "make",
        "coreutils"
      ],
      "build_system": "autotools",
      "configure_args": [
        "--with-openssl",
        "--with-curl",
        "--with-libpcre",
        "--without-tcltk",
        "--with-zlib"
      ],
      "env": {},
      "env_darwin": {
        "LDFLAGS": "-L$TSI_INSTALL_DIR/lib -lintl"
      }
    }
  ]
}

    "sha256": "fd905380691ac65ea5a93779e8214941829e3d6e038d5edff9eac5fd74cbed02"
  },
  "dependencies": [
    "openssl",
    "cjson"
  ],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DDOCUMENTATION=OFF",
    "-DWITH_WEBSOCKETS=OFF",

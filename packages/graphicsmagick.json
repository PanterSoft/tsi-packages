{
  "name": "graphicsmagick",
  "version": "1.3.45",
  "description": "Image processing system derived from ImageMagick",
  "source": {
    "type": "tarball",
    "url": "https://downloads.sourceforge.net/project/graphicsmagick/graphicsmagick/1.3.45/GraphicsMagick-1.3.45.tar.xz"
  },
  "dependencies": [
    "libpng",
    "libjpeg-turbo",
    "libtiff",
    "libwebp",
    "freetype",
    "zlib",
    "xz",
    "bzip2"
  ],
  "build_dependencies": [
    "pkg-config"
  ],
  "build_system": "autotools",
  "configure_args": [
    "--disable-static",
    "--enable-shared",
    "--without-x",
    "--disable-openmp",
    "--without-perl",
    "--without-gslib",
    "--without-wmf",
    "--without-jxl",
    "--without-heif"
  ],
  "env": {}
}

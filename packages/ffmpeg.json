{
  "name": "ffmpeg",
  "version": "8.1.3",
  "description": "Complete solution to record, convert and stream audio and video",
  "source": {
    "type": "tarball",
    "url": "https://ffmpeg.org/releases/ffmpeg-8.1.3.tar.xz",
    "sha256": "7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3"
  },
  "dependencies": [],
  "build_dependencies": [
    "nasm",
    "pkg-config"
  ],
  "build_system": "custom",
  "build_commands": [
    "./configure --prefix=$TSI_INSTALL_DIR --enable-shared --disable-static --disable-doc --extra-cflags=\"$CPPFLAGS\" --extra-ldflags=\"$LDFLAGS\"",
    "make -j$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)",
    "make install"
  ],
  "env": {}
}

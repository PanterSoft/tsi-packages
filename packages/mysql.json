{
  "name": "mysql",
  "version": "8.0.36",
  "description": "MySQL database server",
  "source": {
    "type": "tarball",
    "url": "https://cdn.mysql.com/archives/mysql-8.0/mysql-boost-8.0.36.tar.gz"
  },
  "dependencies": [
    "openssl",
    "zlib",
    "zstd"
  ],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DWITH_SSL=system",
    "-DWITH_ZLIB=system",
    "-DWITH_ZSTD=system",
    "-DWITH_BOOST=boost",
    "-DDOWNLOAD_BOOST=0"
  ],
  "env": {}
}

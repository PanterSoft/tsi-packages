{
  "name": "mysql",
  "version": "8.0.36",
  "description": "MySQL database server",
  "source": {
    "type": "tarball",
    "url": "https://cdn.mysql.com/archives/mysql-8.0/mysql-boost-8.0.36.tar.gz",
    "sha256": "429c5f69f3722e31807e74119d157a023277af210bfee513443cae60ebd2a86d"
  },
  "dependencies": [
    "openssl",
    "zlib",
    "zstd"
  ],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "custom",
  "build_commands": [
    "cmake -S . -B tsi-build -DCMAKE_INSTALL_PREFIX=$TSI_INSTALL_DIR -DCMAKE_BUILD_TYPE=Release -DWITH_SSL=system -DWITH_ZLIB=system -DWITH_ZSTD=system -DDOWNLOAD_BOOST=0 -DWITH_BOOST=\"$PWD/boost\" -DWITH_UNIT_TESTS=OFF -DWITHOUT_GROUP_REPLICATION=1",
    "cmake --build tsi-build -j \"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)\"",
    "cmake --install tsi-build"
  ],
  "env": {}
}

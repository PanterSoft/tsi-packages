{
  "name": "xmlsec1",
  "version": "1.3.5",
  "description": "XML Security library (XML Signature and Encryption)",
  "source": {
    "type": "tarball",
    "url": "https://github.com/lsh123/xmlsec/releases/download/1.3.5/xmlsec1-1.3.5.tar.gz",
    "sha256": "2ffd4ad1f860ec93e47a680310ab2bc94968bd07566e71976bd96133d9504917"
  },
  "dependencies": [
    "libxml2",
    "libxslt",
    "openssl"
  ],
  "build_dependencies": [
    "pkg-config"
  ],
  "build_system": "autotools",
  "configure_args": [
    "--disable-static",
    "--with-openssl=$TSI_INSTALL_DIR",
    "--without-gnutls",
    "--without-gcrypt",
    "--without-nss",
    "--disable-docs",
    "--disable-apps-crypto-dl",
    "--disable-crypto-dl"
  ],
  "env": {}
}

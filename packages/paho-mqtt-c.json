{
  "name": "paho-mqtt-c",
  "version": "1.3.14",
  "description": "Eclipse Paho MQTT client library for C",
  "source": {
    "type": "tarball",
    "url": "https://github.com/eclipse-paho/paho.mqtt.c/archive/refs/tags/v1.3.14.tar.gz"
  },
  "dependencies": [
    "openssl"
  ],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DPAHO_WITH_SSL=ON",
    "-DPAHO_BUILD_SAMPLES=OFF",
    "-DPAHO_ENABLE_TESTING=OFF",
    "-DPAHO_BUILD_DOCUMENTATION=OFF"
  ],
  "env": {}
}

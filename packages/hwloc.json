{
  "name": "hwloc",
  "version": "2.11.2",
  "description": "Portable abstraction of the hierarchical topology of modern architectures",
  "source": {
    "type": "tarball",
    "url": "https://download.open-mpi.org/release/hwloc/v2.11/hwloc-2.11.2.tar.bz2"
  },
  "dependencies": [],
  "build_dependencies": [
    "pkg-config"
  ],
  "build_system": "autotools",
  "configure_args": [
    "--disable-static",
    "--disable-cairo",
    "--disable-libxml2",
    "--disable-opencl",
    "--disable-cuda",
    "--disable-nvml",
    "--disable-rsmi",
    "--disable-levelzero",
    "--disable-gl",
    "--disable-libudev"
  ],
  "env": {}
}

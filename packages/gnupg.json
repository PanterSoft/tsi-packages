{
  "name": "gnupg",
  "version": "2.4.9",
  "description": "GNU Privacy Guard: OpenPGP and S/MIME encryption and signing",
  "source": {
    "type": "tarball",
    "url": "https://gnupg.org/ftp/gcrypt/gnupg/gnupg-2.4.9.tar.bz2"
  },
  "dependencies": [
    "libgpg-error",
    "libgcrypt",
    "libassuan",
    "libksba",
    "npth",
    "zlib",
    "bzip2",
    "sqlite",
    "readline"
  ],
  "build_dependencies": [],
  "build_system": "autotools",
  "configure_args": [
    "--disable-doc",
    "--disable-ldap",
    "--disable-gnutls",
    "--disable-ccid-driver",
    "--with-libgpg-error-prefix=$TSI_INSTALL_DIR",
    "--with-libgcrypt-prefix=$TSI_INSTALL_DIR",
    "--with-libassuan-prefix=$TSI_INSTALL_DIR",
    "--with-ksba-prefix=$TSI_INSTALL_DIR",
    "--with-npth-prefix=$TSI_INSTALL_DIR",
    "--with-zlib=$TSI_INSTALL_DIR",
    "--with-bzip2=$TSI_INSTALL_DIR",
    "--with-readline=$TSI_INSTALL_DIR"
  ],
  "env": {}
}

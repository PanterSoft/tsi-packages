{
  "name": "glog",
  "version": "0.7.1",
  "description": "Application-level logging library for C++",
  "source": {
    "type": "tarball",
    "url": "https://github.com/google/glog/archive/refs/tags/v0.7.1.tar.gz"
  },
  "dependencies": [],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DBUILD_SHARED_LIBS=ON",
    "-DBUILD_TESTING=OFF",
    "-DWITH_GFLAGS=OFF",
    "-DWITH_GTEST=OFF",
    "-DWITH_UNWIND=OFF"
  ],
  "env": {}
}

{
  "name": "box2d",
  "version": "3.1.1",
  "description": "2D physics engine for games",
  "source": {
    "type": "tarball",
    "url": "https://github.com/erincatto/box2d/archive/refs/tags/v3.1.1.tar.gz"
  },
  "dependencies": [],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DBUILD_SHARED_LIBS=ON",
    "-DBOX2D_SAMPLES=OFF",
    "-DBOX2D_UNIT_TESTS=OFF",
    "-DBOX2D_BENCHMARKS=OFF"
  ],
  "env": {}
}

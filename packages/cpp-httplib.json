{
  "name": "cpp-httplib",
  "version": "0.20.0",
  "description": "C++11 single-file header-only HTTP/HTTPS server and client library",
  "source": {
    "type": "tarball",
    "url": "https://github.com/yhirose/cpp-httplib/archive/refs/tags/v0.20.0.tar.gz",
    "sha256": "18064587e0cc6a0d5d56d619f4cbbcaba47aa5d84d86013abbd45d95c6653866"
  },
  "dependencies": [],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DHTTPLIB_REQUIRE_OPENSSL=OFF",
    "-DHTTPLIB_USE_OPENSSL_IF_AVAILABLE=OFF",
    "-DHTTPLIB_USE_ZLIB_IF_AVAILABLE=OFF",
    "-DHTTPLIB_USE_BROTLI_IF_AVAILABLE=OFF",
    "-DHTTPLIB_TEST=OFF"
  ],
  "env": {}
}

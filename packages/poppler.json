{
  "name": "poppler",
  "version": "24.12.0",
  "description": "PDF rendering library and command-line utilities (pdftotext, pdfinfo, ...)",
  "source": {
    "type": "tarball",
    "url": "https://poppler.freedesktop.org/poppler-24.12.0.tar.xz",
    "sha256": "1cf374c3146f3f685d9257701bf0c2866c61d6c202c14d1f5c01a1f3a089028a"
  },
  "dependencies": [
    "freetype",
    "fontconfig",
    "cairo",
    "lcms2",
    "openjpeg",
    "libtiff",
    "libpng",
    "libjpeg-turbo",
    "zlib"
  ],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils",
    "pkg-config"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DENABLE_BOOST=OFF",
    "-DENABLE_QT5=OFF",
    "-DENABLE_QT6=OFF",
    "-DENABLE_GPGME=OFF",
    "-DENABLE_NSS3=OFF",
    "-DENABLE_LIBCURL=OFF",
    "-DENABLE_GLIB=OFF",
    "-DBUILD_GTK_TESTS=OFF",
    "-DBUILD_QT5_TESTS=OFF",
    "-DBUILD_QT6_TESTS=OFF",
    "-DBUILD_CPP_TESTS=OFF",
    "-DBUILD_MANUAL_TESTS=OFF",
    "-DENABLE_UNSTABLE_API_ABI_HEADERS=ON"
  ],
  "env": {}
}

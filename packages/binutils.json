{
  "name": "binutils",
  "version": "2.41",
  "description": "GNU Binary Utilities - linker, assembler, and other tools (ld, as, ar, objdump, etc.)",
  "source": {
    "type": "tarball",
    "url": "https://ftp.gnu.org/gnu/binutils/binutils-2.41.tar.xz",
    "sha256": "ae9a5789e23459e59606e6714723f2d3ffc31c03174191ef0d015bdf06007450"
  },
  "dependencies": [
    "zlib"
  ],
  "build_dependencies": [
    "m4",
    "bash",
    "coreutils",
    "make"
  ],
  "build_system": "autotools",
  "configure_args": [
    "--disable-werror",
    "--enable-gold",
    "--enable-ld=default",
    "--enable-plugins",
    "--enable-shared",
    "--with-system-zlib"
  ],
  "env": {
    "ZLIB_NO_FDOPEN_WRAPPER": "1"
  }
}

{
  "name": "libaom",
  "version": "3.12.1",
  "description": "AV1 video codec reference library",
  "source": {
    "type": "tarball",
    "url": "https://storage.googleapis.com/aom-releases/libaom-3.12.1.tar.gz"
  },
  "dependencies": [],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils",
    "nasm"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DBUILD_SHARED_LIBS=ON",
    "-DENABLE_TESTS=OFF",
    "-DENABLE_DOCS=OFF",
    "-DENABLE_EXAMPLES=OFF",
    "-DENABLE_TESTDATA=OFF"
  ],
  "env": {}
}

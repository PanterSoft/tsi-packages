{
  "name": "openssh",
  "version": "10.5p1",
  "description": "OpenSSH portable: SSH client, server and key tools",
  "source": {
    "type": "tarball",
    "url": "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-10.5p1.tar.gz"
  },
  "dependencies": [
    "openssl",
    "zlib"
  ],
  "build_dependencies": [],
  "build_system": "autotools",
  "configure_args": [
    "--with-ssl-dir=$TSI_INSTALL_DIR",
    "--with-zlib=$TSI_INSTALL_DIR",
    "--without-pam",
    "--with-privsep-path=$TSI_INSTALL_DIR/var/empty",
    "--with-pid-dir=$TSI_INSTALL_DIR/var/run"
  ],
  "env": {}
}

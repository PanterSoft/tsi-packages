{
  "name": "zopfli",
  "version": "1.0.3",
  "description": "Very good, but slow, deflate/zlib/gzip compressor",
  "source": {
    "type": "tarball",
    "url": "https://github.com/google/zopfli/archive/refs/tags/zopfli-1.0.3.tar.gz"
  },
  "dependencies": [],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DZOPFLI_BUILD_SHARED=ON",
    "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
  ],
  "env": {}
}

{
  "name": "libzip",
  "versions": [
    {
      "version": "1.12.1",
      "description": "C library for reading, creating and modifying zip archives",
      "source": {
        "type": "tarball",
        "url": "https://github.com/nih-at/libzip/releases/download/v1.12.1/libzip-1.12.1.tar.xz",
        "sha256": "c40062022a1963c80573d48f6070792297cecd7c6bffe3aefcac0d8b9bee8913"
      },
      "dependencies": [
        "zlib",
        "bzip2",
        "xz",
        "zstd"
      ],
      "build_dependencies": [
        "cmake",
        "make",
        "coreutils"
      ],
      "build_system": "cmake",
      "cmake_args": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DENABLE_GNUTLS=OFF",
        "-DENABLE_MBEDTLS=OFF",
        "-DENABLE_OPENSSL=OFF",
        "-DENABLE_COMMONCRYPTO=OFF",
        "-DBUILD_REGRESS=OFF",
        "-DBUILD_OSSFUZZ=OFF",
        "-DBUILD_EXAMPLES=OFF",
        "-DBUILD_DOC=OFF"
      ],
      "env": {}
    },

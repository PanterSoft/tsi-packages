{
  "name": "postgresql",
  "version": "16.15",
  "description": "PostgreSQL database server",
  "source": {
    "type": "tarball",
    "url": "https://ftp.postgresql.org/pub/source/v16.15/postgresql-16.15.tar.gz",
    "sha256": "4f200ca23dfb120ff9838f13ce06014aad1d3c432d16ee9f93ab2000c0eeef7b"
  },
  "dependencies": [
    "openssl",
    "zlib",
    "readline",
    "icu"
  ],
  "build_dependencies": [
    "make",
    "coreutils",
    "pkg-config"
  ],
  "build_system": "autotools",
  "configure_args": [
    "--with-openssl",
    "--with-readline",
    "--with-icu",
    "--without-perl",
    "--without-python"
  ],
  "env": {},
  "env_darwin": {
    "CPPFLAGS": "-I$TSI_INSTALL_DIR/include"
  }
}

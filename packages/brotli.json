{
  "name": "brotli",
  "versions": [
    {
      "version": "1.1.0",
      "description": "Generic-purpose lossless compression algorithm",
      "source": {
        "type": "tarball",
        "url": "https://github.com/google/brotli/archive/refs/tags/v1.1.0.tar.gz"
      },
      "dependencies": [],
      "build_dependencies": [
        "cmake",
        "make",
        "coreutils"
      ],
      "build_system": "cmake",
      "cmake_args": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DBROTLI_DISABLE_TESTS=ON"
      ],
      "env": {}
    }
  ]
}

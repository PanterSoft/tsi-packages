{
  "name": "mongo-c-driver",
  "version": "2.5.5",
  "description": "MongoDB C driver (libmongoc and libbson)",
  "source": {
    "type": "tarball",
    "url": "https://github.com/mongodb/mongo-c-driver/releases/download/2.5.5/mongo-c-driver-2.5.5.tar.gz",
    "sha256": "fa255802fe748b98d4464e07223e87a44c88c02c35398d7607b2f02e967395b1"
  },
  "dependencies": [
    "openssl",
    "zlib",
    "zstd"
  ],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DENABLE_TESTS=OFF",
    "-DENABLE_EXAMPLES=OFF",
    "-DENABLE_SASL=OFF",
    "-DENABLE_SNAPPY=OFF",
    "-DENABLE_ZSTD=ON",
    "-DENABLE_SSL=OPENSSL",
    "-DENABLE_UNINSTALL=OFF",
    "-DENABLE_STATIC=OFF"
  ],
  "env": {}
}

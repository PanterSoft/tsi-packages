{
  "name": "x265",
  "version": "4.1",
  "description": "HEVC (H.265) video encoder library and tool",
  "source": {
    "type": "tarball",
    "url": "https://bitbucket.org/multicoreware/x265_git/downloads/x265_4.1.tar.gz",
    "sha256": "a31699c6a89806b74b0151e5e6a7df65de4b49050482fe5ebf8a4379d7af8f29"
  },
  "dependencies": [],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils",
    "nasm"
  ],
  "build_system": "custom",
  "env": {},
  "build_commands": [
    "sed -i.orig -e '/cmake_policy(SET CMP[0-9]* OLD)/d' source/CMakeLists.txt",
    "cmake -S source -B build-tsi -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$TSI_INSTALL_DIR -DCMAKE_INSTALL_NAME_DIR=$TSI_INSTALL_DIR/lib -DENABLE_SHARED=ON -DENABLE_CLI=ON -DCMAKE_POLICY_VERSION_MINIMUM=3.5",
    "cmake --build build-tsi -j4",
    "cmake --install build-tsi"
  ]
}

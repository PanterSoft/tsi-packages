{
  "name": "libraw",
  "version": "0.21.3",
  "description": "Library for reading RAW files from digital cameras",
  "source": {
    "type": "tarball",
    "url": "https://www.libraw.org/data/LibRaw-0.21.3.tar.gz"
  },
  "dependencies": [
    "libjpeg-turbo",
    "lcms2",
    "zlib"
  ],
  "build_dependencies": [
    "pkg-config"
  ],
  "build_system": "autotools",
  "configure_args": [
    "--disable-static",
    "--disable-examples",
    "--disable-openmp"
  ],
  "env": {}
}

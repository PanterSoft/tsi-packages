{
  "name": "nginx",
  "version": "1.30.5",
  "description": "HTTP and reverse proxy server",
  "source": {
    "type": "tarball",
    "url": "https://nginx.org/download/nginx-1.30.5.tar.gz"
  },
  "dependencies": [
    "pcre2",
    "zlib",
    "openssl"
  ],
  "build_dependencies": [],
  "build_system": "custom",
  "build_commands": [
    "./configure --prefix=$TSI_INSTALL_DIR --with-http_ssl_module --with-http_v2_module --with-http_realip_module --with-http_gzip_static_module --with-http_stub_status_module --with-stream --with-stream_ssl_module --with-pcre-jit --with-cc-opt=\"$CFLAGS $CPPFLAGS\" --with-ld-opt=\"$LDFLAGS\"",
    "make -j$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)",
    "make install"
  ],
  "env": {}
}

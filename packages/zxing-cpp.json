{
  "name": "zxing-cpp",
  "version": "2.3.0",
  "description": "Multi-format 1D/2D barcode image processing library",
  "source": {
    "type": "tarball",
    "url": "https://github.com/zxing-cpp/zxing-cpp/archive/refs/tags/v2.3.0.tar.gz"
  },
  "dependencies": [],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DBUILD_SHARED_LIBS=ON",
    "-DZXING_EXAMPLES=OFF",
    "-DZXING_BLACKBOX_TESTS=OFF",
    "-DZXING_UNIT_TESTS=OFF",
    "-DZXING_PYTHON_MODULE=OFF"
  ],
  "env": {}
}

{
  "name": "openexr",
  "version": "3.3.2",
  "description": "High dynamic-range (HDR) image file format library and tools",
  "source": {
    "type": "tarball",
    "url": "https://github.com/AcademySoftwareFoundation/openexr/archive/refs/tags/v3.3.2.tar.gz",
    "sha256": "5013e964de7399bff1dd328cbf65d239a989a7be53255092fa10b85a8715744d"
  },
  "dependencies": [
    "imath",
    "libdeflate"
  ],
  "build_dependencies": [
    "cmake",
    "make",
    "coreutils",
    "pkg-config"
  ],
  "build_system": "cmake",
  "cmake_args": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DBUILD_TESTING=OFF",
    "-DOPENEXR_BUILD_EXAMPLES=OFF",
    "-DOPENEXR_INSTALL_EXAMPLES=OFF",
    "-DOPENEXR_FORCE_INTERNAL_DEFLATE=OFF",
    "-DOPENEXR_FORCE_INTERNAL_IMATH=OFF"
  ],
  "env": {}
}

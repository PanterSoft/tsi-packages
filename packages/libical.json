    "-DSHARED_ONLY=ON"
  ],
  "env": {},
  "cmake_args_darwin": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DICAL_GLIB=OFF",
    "-DGOBJECT_INTROSPECTION=OFF",
    "-DICAL_BUILD_DOCS=OFF",
    "-DENABLE_GTK_DOC=OFF",
    "-DLIBICAL_BUILD_TESTING=OFF",
    "-DSHARED_ONLY=ON",
    "-DCMAKE_DISABLE_FIND_PACKAGE_ICU=ON"
  ]
}
